{
  "name": "ghsoon-zahran-system",
  "version": "1.0.0",
  "description": "نظام إدارة جمعية غصون زهران الخيرية - تطبيق سطح مكتب محلي",
  "private": true,
  "author": "Ghsoon Zahran Charity",
  "main": "electron/dist/electron/main.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev -p 3100",
    "dev:electron": "npm run build:electron && concurrently -k \"npm:dev\" \"wait-on http://localhost:3100 && electron .\"",
    "build": "next build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:all": "npm run build && npm run build:electron",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p electron/tsconfig.json",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "generate:triggers": "tsx scripts/generate-sqlite-triggers.ts",
    "init:db": "tsx scripts/init-db.ts",
    "dist:win": "npm run build:all && electron-builder --win"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "archiver": "^7.0.1",
    "archiver-utils": "^5.0.2",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "docx": "^9.0.2",
    "exceljs": "^4.4.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "unzipper": "^0.12.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/unzipper": "^0.10.10",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "wait-on": "^8.0.0"
  }
}
