// جمعية غصون زهران الخيرية — Local SQLite schema
// Money: all monetary values stored as Int in fils (1 JOD = 1000 fils). NEVER Float/Decimal for money.
// Enums: SQLite + Prisma does not support native enums -> stored as String, allowed values enforced by
// CHECK-style triggers in prisma/sqlite-sql/constraints-and-context.sql (see comments per field below).

generator client {
  provider = "prisma-client-js"
  // Generating into node_modules/.prisma (the default) breaks electron-builder
  // packaging: its node_modules walker never picks up that dot-prefixed
  // directory, so the packaged app throws "Cannot find module
  // '.prisma/client/default'" at startup even though it works in every dev/
  // test run here. A plain, non-hidden output directory sidesteps the bug
  // entirely and is Prisma's own recommended fix for bundler/packager
  // compatibility issues like this one.
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── AUTH & ACCESS ───────────────────────────────

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  fullName     String
  passwordHash String
  roleId       String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  role           Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions       Session[]
  fieldVisits    FieldVisit[]
  approvals      Approval[]
  notifications  Notification[]
  responsibleFor Family[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

/// Every login attempt, successful or not. Deliberately NOT a foreign key to
/// users: a failed attempt usually names a username that does not exist, and
/// that fact is exactly what makes the row worth keeping.
model LoginAttempt {
  id          String   @id @default(cuid())
  username    String
  successful  Boolean
  reason      String? // BAD_PASSWORD | UNKNOWN_USER | INACTIVE_USER
  attemptedAt DateTime @default(now())

  @@index([username, attemptedAt])
  @@map("login_attempts")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id     String @id @default(cuid())
  module String
  action String // view | create | update | delete | export | approve

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ─────────────────────────────── FAMILIES ───────────────────────────────

/// Geographic regions ("المنطقة"). Free-form list managed from Settings; the
/// neighborhood ("الحي") stays plain text on the family because neighborhood
/// naming is not consistent enough across regions to be worth a lookup table.
model Region {
  id        String   @id @default(cuid())
  name      String   @unique
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  families Family[]

  @@map("regions")
}

model Family {
  id                     String   @id @default(cuid())
  familyCode             String   @unique
  headOfFamilyName       String
  wifeName               String?
  headNationalId         String?
  /// "عدد الأفراد في دفتر العائلة" — deliberately nullable. The imported
  /// legacy records leave it blank and it is never inferred or generated.
  familyBookMembersCount Int?
  address                String?
  city                   String?
  regionId               String?
  neighborhood           String?
  phone                  String?
  altPhone               String?
  maritalStatus          String? // أعزب | متزوج | مطلق | أرمل
  housingType            String? // ملك | إيجار | أخرى
  incomeSource           String?
  monthlyIncomeFils      Int      @default(0)
  monthlyExpensesFils    Int      @default(0)
  healthStatus           String?
  needLevel              String? // شديد الحاجة | متوسط الحاجة | قليل الحاجة
  economicLevel          String? // فقير جداً | فقير | متوسط | ميسور (lookup-controlled)
  fileStatus             String   @default("نشط") // نشط | موقوف | مؤرشف
  registeredAt           DateTime @default(now())
  responsibleUserId      String?
  notes                  String?
  /// Provenance of the record: "يدوي" for rows typed into this app,
  /// "استيراد أولي" for the 330 legacy families, "الهاتف" for rows that
  /// arrived through a .gztransfer package.
  sourceSystem           String   @default("يدوي")
  /// Stable legacy key ("تسلسل" from the import sheet, e.g. "XLSX-330:17").
  /// Unique, and the sole thing that makes re-running the import a no-op.
  legacyReference        String?  @unique
  /// The original register citations ("مراجع القيود الأصلية") and how many
  /// times the name appeared before duplicates were merged — kept verbatim
  /// as source metadata so the paper trail back to the registers survives.
  legacySourceRefs       String?
  legacyOccurrences      Int?
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  region            Region?            @relation(fields: [regionId], references: [id], onDelete: SetNull)
  responsibleUser   User?              @relation(fields: [responsibleUserId], references: [id], onDelete: SetNull)
  members           FamilyMember[]
  beneficiaries     Beneficiary[]
  socialAssessments SocialAssessment[]
  fieldVisits       FieldVisit[]
  assistances       Assistance[]

  @@index([regionId])
  @@index([headOfFamilyName])
  @@index([headNationalId])
  @@map("families")
}

model FamilyMember {
  id                String    @id @default(cuid())
  familyId          String
  fullName          String
  nationalId        String?
  relationship      String // رب أسرة | زوجة | ابن | ابنة | أخرى
  gender            String // ذكر | أنثى
  birthDate         DateTime?
  maritalStatus     String? // أعزب | متزوج | مطلق | أرمل
  educationLevel    String?
  isDisabled        Boolean   @default(false)
  disabilityType    String?
  isOrphan          Boolean   @default(false)
  isStudent         Boolean   @default(false)
  healthStatus      String?
  occupation        String?
  monthlyIncomeFils Int       @default(0)
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("family_members")
}

model Beneficiary {
  id         String    @id @default(cuid())
  familyId   String
  fullName   String
  nationalId String?
  phone      String?
  birthDate  DateTime?
  gender     String?
  category   String? // يتيم | مسن | مريض | ذوي إعاقة | أخرى
  status     String    @default("نشط") // نشط | موقوف | مرفوض
  notes      String?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  family        Family             @relation(fields: [familyId], references: [id], onDelete: Restrict)
  assessments   SocialAssessment[]
  assistances   Assistance[]
  campaignItems CampaignItem[]
  fieldVisits   FieldVisit[]

  @@index([familyId])
  @@index([nationalId])
  @@map("beneficiaries")
}

// ─────────────────────────────── SOCIAL RESEARCH ───────────────────────────────

model SocialAssessment {
  id                   String   @id @default(cuid())
  familyId             String
  beneficiaryId        String?
  researcherId         String?
  assessmentDate       DateTime @default(now())
  monthlyIncomeFils    Int      @default(0)
  monthlyExpensesFils  Int      @default(0)
  economicLevel        String?
  housingCondition     String?
  housingOwnership     String? // ملك | إيجار | أخرى
  roomsCount           Int?
  healthCondition      String?
  chronicDiseases      String?
  disabilities         String?
  childrenCount        Int?
  orphansCount         Int?
  studentsCount        Int?
  unemployedCount      Int?
  financialObligations String?
  basicNeeds           String?
  needLevel            String? // شديد الحاجة | متوسط الحاجة | قليل الحاجة
  educationLevel       String?
  recommendation       String?
  score                Int?
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  family      Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  beneficiary Beneficiary? @relation(fields: [beneficiaryId], references: [id], onDelete: SetNull)

  @@index([familyId])
  @@map("social_assessments")
}

model FieldVisit {
  id             String    @id @default(cuid())
  familyId       String
  beneficiaryId  String?
  userId         String?
  visitDate      DateTime  @default(now())
  purpose        String?
  findings       String?
  recommendation String?
  notes          String?
  status         String    @default("مكتملة") // مجدولة | مكتملة | ملغاة
  nextVisitAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  family      Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  beneficiary Beneficiary? @relation(fields: [beneficiaryId], references: [id], onDelete: SetNull)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([familyId])
  @@map("field_visits")
}

// ─────────────────────────────── ASSISTANCES / CAMPAIGNS ───────────────────────────────

model AssistanceType {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String // نقدي | عيني
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assistances Assistance[]

  @@map("assistance_types")
}

model Assistance {
  id               String   @id @default(cuid())
  /// Human-facing operation number ("رقم عملية"), e.g. ASST-2026-000123.
  /// Assigned by the service layer; unique so it can be quoted on paperwork.
  operationNo      String?  @unique
  beneficiaryId    String
  familyId         String
  assistanceTypeId String
  campaignId       String?
  amountFils       Int      @default(0)
  inventoryItemId  String?
  quantity         Int?
  unit             String?
  source           String? // المصدر: مخزون | تبرع | ميزانية الجمعية | أخرى
  status           String   @default("مصروفة") // معلقة | موافق عليها | مصروفة | مرفوضة
  approvedById     String?
  recordedById     String?
  disbursedAt      DateTime @default(now())
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  beneficiary    Beneficiary    @relation(fields: [beneficiaryId], references: [id], onDelete: Restrict)
  family         Family         @relation(fields: [familyId], references: [id], onDelete: Restrict)
  assistanceType AssistanceType @relation(fields: [assistanceTypeId], references: [id], onDelete: Restrict)
  campaign       Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  inventoryItem  InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([beneficiaryId])
  @@index([familyId])
  @@map("assistances")
}

model Campaign {
  id                  String    @id @default(cuid())
  name                String
  description         String?
  goal                String?
  startDate           DateTime?
  endDate             DateTime?
  targetAmountFils    Int       @default(0)
  /// Approved budget. Spent/remaining are NOT stored: they are derived from
  /// the campaign's assistances and transactions so they can never drift.
  budgetFils          Int       @default(0)
  targetFamiliesCount Int?
  targetPersonsCount  Int?
  supporters          String?
  status              String    @default("مفتوحة") // مخطط لها | مفتوحة | مغلقة
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  items       CampaignItem[]
  assistances Assistance[]
  donations   Donation[]

  @@map("campaigns")
}

model CampaignItem {
  id                String   @id @default(cuid())
  campaignId        String
  beneficiaryId     String
  plannedAmountFils Int      @default(0)
  status            String   @default("مخطط") // مخطط | تم الصرف
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  campaign    Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Restrict)

  @@index([campaignId])
  @@map("campaign_items")
}

// ─────────────────────────────── WAREHOUSE / INVENTORY ───────────────────────────────

model Warehouse {
  id        String   @id @default(cuid())
  name      String   @unique
  location  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryItems InventoryItem[]

  @@map("warehouses")
}

model InventoryItem {
  id            String   @id @default(cuid())
  warehouseId   String
  /// Item code ("الكود"). Unique when present so barcodes/asset codes stay
  /// unambiguous, but optional — small charities rarely code everything.
  code          String?  @unique
  name          String
  unit          String // قطعة | كرتون | كيلو ...
  quantity      Int      @default(0)
  minQuantity   Int      @default(0)
  unitPriceFils Int      @default(0)
  category      String?
  supplierId    String?
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  supplier    Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  stockIns    StockIn[]
  stockOuts   StockOut[]
  assistances Assistance[]

  @@index([warehouseId])
  @@map("inventory_items")
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockIns       StockIn[]
  inventoryItems InventoryItem[]

  @@map("suppliers")
}

model StockIn {
  id              String   @id @default(cuid())
  inventoryItemId String
  supplierId      String?
  quantity        Int
  unitPriceFils   Int      @default(0)
  totalFils       Int      @default(0)
  referenceNo     String?
  receivedAt      DateTime @default(now())
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  supplier      Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([inventoryItemId])
  @@map("stock_in")
}

model StockOut {
  id              String   @id @default(cuid())
  inventoryItemId String
  quantity        Int
  reason          String // مساعدة | تالف | جرد | أخرى
  referenceId     String? // e.g. related assistance id
  issuedAt        DateTime @default(now())
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([inventoryItemId])
  @@map("stock_out")
}

// ─────────────────────────────── DONORS / DONATIONS ───────────────────────────────

model Donor {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  donorType String   @default("فرد") // فرد | مؤسسة
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  donations Donation[]

  @@map("donors")
}

model Donation {
  id                String   @id @default(cuid())
  donorId           String
  campaignId        String?
  amountFils        Int      @default(0)
  currency          String   @default("JOD")
  donationType      String   @default("نقدي") // نقدي | عيني
  /// Description of an in-kind donation ("التبرع العيني"). Only meaningful
  /// when donationType = عيني, where amountFils holds the estimated value.
  inKindDescription String?
  method            String? // كاش | تحويل بنكي | شيك
  donatedAt         DateTime @default(now())
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  donor    Donor     @relation(fields: [donorId], references: [id], onDelete: Restrict)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  receipts Receipt[]

  @@index([donorId])
  @@map("donations")
}

model Receipt {
  id         String   @id @default(cuid())
  donationId String
  receiptNo  String   @unique
  amountFils Int      @default(0)
  issuedAt   DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  donation Donation @relation(fields: [donationId], references: [id], onDelete: Restrict)

  @@map("receipts")
}

// ─────────────────────────────── ACCOUNTING ───────────────────────────────

model ExpenseCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  @@map("expense_categories")
}

model Transaction {
  id            String   @id @default(cuid())
  type          String // دخل | مصروف
  amountFils    Int
  categoryId    String?
  description   String?
  referenceType String? // donation | assistance | manual
  referenceId   String?
  transactionAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([transactionAt])
  @@map("transactions")
}

// ─────────────────────────────── SYSTEM ───────────────────────────────

model Attachment {
  id           String   @id @default(cuid())
  fileName     String
  storedName   String
  entityType   String // families | beneficiaries | assistances | donations | ...
  entityId     String
  mimeType     String
  sizeBytes    Int
  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([entityType, entityId])
  @@map("attachments")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  title     String
  message   String
  isRead    Boolean  @default(false)
  level     String   @default("معلومة") // معلومة | تحذير | خطأ
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Approval {
  id            String    @id @default(cuid())
  entityType    String
  entityId      String
  status        String    @default("قيد الانتظار") // قيد الانتظار | موافق عليه | مرفوض
  requestedById String?
  approvedById  String?
  decidedAt     DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  approver User? @relation(fields: [approvedById], references: [id], onDelete: SetNull)

  @@map("approvals")
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@map("settings")
}

model LookupValue {
  id        String  @id @default(cuid())
  category  String // housing_type | economic_level | relationship | assistance_category ...
  value     String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  @@unique([category, value])
  @@map("lookup_values")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  username  String?
  action    String // INSERT | UPDATE | DELETE
  tableName String
  recordId  String
  oldValues String? // JSON
  newValues String? // JSON
  createdAt DateTime @default(now())

  @@index([tableName, recordId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────── IMPORT / TRANSFER ───────────────────────────────

/// One row per completed data import. `sourceKey` is what makes an import
/// idempotent: for the bundled 330-family sheet it is a fixed constant, and
/// for a phone transfer package it is the package's SHA-256 checksum. Unique,
/// so the same source can never be committed twice.
model ImportBatch {
  id            String   @id @default(cuid())
  kind          String // legacy_families | mobile_transfer
  sourceKey     String   @unique
  sourceName    String
  deviceId      String?
  sourceUser    String?
  schemaVersion String?
  createdCount  Int      @default(0)
  updatedCount  Int      @default(0)
  skippedCount  Int      @default(0)
  errorCount    Int      @default(0)
  summary       String? // JSON — per-entity counts
  storedFile    String? // copy of the package kept under metadata/transfers/
  importedById  String?
  importedBy    String?
  importedAt    DateTime @default(now())

  @@index([kind, importedAt])
  @@map("import_batches")
}
